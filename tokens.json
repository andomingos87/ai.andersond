{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "ai.andersond",
    "direction": "Lousa",
    "version": "1.0.0",
    "updated": "2026-09-10",
    "status": "aprovado por Anderson em 10/09/2026 (verde lousa, acento frio, Bricolage travada)"
  },
  "color": {
    "lousa": {
      "$type": "color",
      "$value": "#1E3B33",
      "$description": "Base. Fundo padrao de capas, cartelas e thumbnails."
    },
    "lousa-escura": {
      "$type": "color",
      "$value": "#152A25",
      "$description": "Profundidade, faixas inferiores, lower third."
    },
    "giz": {
      "$type": "color",
      "$value": "#EEE9DC",
      "$description": "Texto sobre lousa. Fundo claro em carrossel e one-pager."
    },
    "cobre": {
      "$type": "color",
      "$value": "#D2823F",
      "$description": "Reservado ao ponto da marca. Nao e acento de layout."
    },
    "menta": {
      "$type": "color",
      "$value": "#9ED3BC",
      "$description": "Acento frio. Linhas, numeros em destaque, graficos, diagramas. Nunca em titulo inteiro."
    },
    "grafite": {
      "$type": "color",
      "$value": "#1F2421",
      "$description": "Texto sobre giz."
    }
  },
  "semantic": {
    "background": {
      "default": {
        "$type": "color",
        "$value": "{color.lousa}"
      },
      "deep": {
        "$type": "color",
        "$value": "{color.lousa-escura}"
      },
      "light": {
        "$type": "color",
        "$value": "{color.giz}"
      }
    },
    "text": {
      "on-dark": {
        "$type": "color",
        "$value": "{color.giz}"
      },
      "on-dark-muted": {
        "$type": "color",
        "$value": "#EEE9DC99",
        "$description": "Giz a 60%."
      },
      "on-light": {
        "$type": "color",
        "$value": "{color.grafite}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.menta}",
        "$description": "Acento frio para numero ou linha de destaque."
      }
    },
    "data": {
      "primary": {
        "$type": "color",
        "$value": "{color.menta}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.giz}"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.giz}"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque",
          "system-ui",
          "sans-serif"
        ]
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "text": {
        "$type": "fontWeight",
        "$value": 400
      },
      "label": {
        "$type": "fontWeight",
        "$value": 500
      },
      "display": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "width": {
      "normal": {
        "$type": "number",
        "$value": 100
      },
      "condensed": {
        "$type": "number",
        "$value": 80,
        "$description": "Titulo que precisa caber em uma linha no Reel."
      }
    },
    "size": {
      "12": {
        "$type": "dimension",
        "$value": "12px"
      },
      "14": {
        "$type": "dimension",
        "$value": "14px"
      },
      "16": {
        "$type": "dimension",
        "$value": "16px"
      },
      "20": {
        "$type": "dimension",
        "$value": "20px"
      },
      "26": {
        "$type": "dimension",
        "$value": "26px"
      },
      "34": {
        "$type": "dimension",
        "$value": "34px"
      },
      "44": {
        "$type": "dimension",
        "$value": "44px"
      },
      "58": {
        "$type": "dimension",
        "$value": "58px"
      },
      "76": {
        "$type": "dimension",
        "$value": "76px"
      }
    },
    "letterSpacing": {
      "display": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "text": {
        "$type": "dimension",
        "$value": "0"
      }
    },
    "lineHeight": {
      "display": {
        "$type": "number",
        "$value": 1.02
      },
      "text": {
        "$type": "number",
        "$value": 1.45
      }
    },
    "case": {
      "$type": "string",
      "$value": "sentence",
      "$description": "Nunca caixa alta."
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "margin-ratio": {
      "$type": "number",
      "$value": 0.06,
      "$description": "Margem = 6% da largura do formato."
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "dot": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Cantos do ponto da marca."
    },
    "photo": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Unico raio permitido em imagem."
    }
  },
  "shadow": {
    "none": {
      "$type": "string",
      "$value": "none",
      "$description": "Sombra nao existe nesta identidade."
    }
  },
  "gradient": {
    "none": {
      "$type": "string",
      "$value": "none",
      "$description": "Gradiente nao existe nesta identidade."
    }
  },
  "logo": {
    "wordmark": {
      "$type": "string",
      "$value": "ai.andersond",
      "$description": "Bricolage 700, giz, ponto em cobre. Ponto = quadrado de cantos suaves, altura 0.18em."
    },
    "mark": {
      "$type": "string",
      "$value": "dot",
      "$description": "Somente o ponto cobre sobre lousa. Unico uso do cobre em toda a identidade."
    },
    "meaning": {
      "$type": "string",
      "$value": "Um ponto por video."
    }
  },
  "formats": {
    "reel": {
      "$type": "string",
      "$value": "1080x1920",
      "$description": "Rosto no terco central; titulo giz 76px no rodape esquerdo; ate 6 palavras."
    },
    "youtube-thumb": {
      "$type": "string",
      "$value": "1280x720",
      "$description": "Rosto no terco esquerdo; titulo nos 2/3 da direita; ate 5 palavras; sem setas."
    },
    "carousel": {
      "$type": "string",
      "$value": "1080x1350",
      "$description": "Capa lousa; paginas giz com texto grafite; ate 40 palavras por pagina."
    },
    "lower-third": {
      "$type": "string",
      "$value": "12% altura",
      "$description": "Faixa lousa-escura na base; nome giz; papel giz 60%; ponto cobre; corte seco."
    }
  }
}